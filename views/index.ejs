

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ChatHaven - Seamless Communication</title>
    <style>
        /* Basic Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #6a11cb, #2575fc);
            color: #333;
            line-height: 1.6;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            text-align: center;
        }

        h1 {
            font-size: 3rem;
            color: #fff;
            margin-bottom: 20px;
        }

        p {
            font-size: 1.2rem;
            color: #555;
            margin-bottom: 40px;
        }

        .nav-links {
            list-style: none;
            display: flex;
            gap: 20px;
            margin-bottom: 40px;
        }

        .nav-links li a {
            text-decoration: none;
            color: #fff;
            background-color: #3498db;
            padding: 10px 20px;
            border-radius: 5px;
            font-size: 1rem;
            transition: background-color 0.3s ease;
        }

        .nav-links li a:hover {
            background-color: #2980b9;
        }

        .cta {
            font-size: 1.5rem;
            color: #fff;
            margin-bottom: 20px;
        }

        .features {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: center;
            align-items: center;
            max-width: 900px;
            width: 100%;
        }

        .feature {
            background-color: #fff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            width: calc(33.33% - 20px);
            min-width: 250px;
            text-align: center;
        }

        @media (max-width: 800px) {
            .feature {
                width: calc(50% - 20px);
            }
        }

        @media (max-width: 500px) {
            .feature {
                width: 100%;
            }
        }

        .feature h3 {
            font-size: 1.5rem;
            color: #2c3e50;
            margin-bottom: 10px;
        }

        .feature p {
            font-size: 1rem;
            color: #555;
        }
    </style>
</head>
<body>
    <h1>Welcome to ChatHaven</h1>
    <p class="cta">Your gateway to seamless communication.</p>

    <ul class="nav-links">
        <li><a href="/register">Sign Up</a></li>
        <li><a href="/login">Login</a></li>
    </ul>

    <div class="features">
        <div class="feature">
            <h3>Real-Time Chat</h3>
            <p>Experience instant messaging with real-time updates.</p>
        </div>
        <div class="feature">
            <h3>Secure & Private</h3>
            <p>Your conversations are encrypted and secure.</p>
        </div>
        <div class="feature">
            <h3>Easy to Use</h3>
            <p>Simple and intuitive interface for everyone.</p>
        </div>
    </div>
</body>
</html>