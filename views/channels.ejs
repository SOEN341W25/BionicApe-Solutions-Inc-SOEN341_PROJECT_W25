<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Channels</title>
    <link rel="stylesheet" href="style.css">
    <style>
        .sidebar {
            width: 250px;
            height: 100vh;
            background-color: #003fab;
            position: fixed;
            left: 0;
            top: 0;
            padding-top: 20px;
            color: white;
            transition: transform 0.3s ease-in-out;
        }

        .sidebar.collapsed {
            transform: translateX(-250px);
        }

        .sidebar a {
            display: block;
            color: white;
            padding: 15px 20px;
            text-decoration: none;
            border: 1px none rgb(0, 0, 0);
            border-radius: 10px;
            margin-bottom: 2px
        }

        .sidebar a:hover {
            background-color: #002d7b;
        }

        /* a[href="http://localhost:3000/api/user/channels"] {
            
            display: block;
            color: white;
            padding: 15px 20px;
            text-decoration: none;
            background-color: red;
        } */


        .toggle-btn {
            position: fixed;
            left: 260px;
            /* Adjust based on sidebar width */
            top: 20px;
            background-color: #003fab;
            color: white;
            border: none;
            border-radius: 10px;
            padding: 10px;
            cursor: pointer;
            z-index: 1000;
            transition: left 0.3s ease-in-out;
        }

        .toggle-btn:hover{
            background-color: #002d7b;
        }

        
        .logo-container {
            display: flex;
            justify-content: center;
            width: 100%;
        }
    </style>
</head>

<body>
    <!-- -->
    <button class="toggle-btn" onclick="toggleSidebar()">Sidenav</button>

    <a class="logout-btn" href="/logout">Logout</a>

    <div class="sidebar" id="sidebar">
        <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar p-3">
            <div class="logo-container">
                <img src="/bionicape.png" alt="Logo" class="img-fluid center" style="max-width: 80px;">
            </div><br><br>

            <form class="form">
                <h3 style="color: rgb(255, 255, 255); font-weight: 700; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin-left: 5px;">Create a Channel:</h3><br>
                <input class="admin-input" type="text" name="channelName" id="channelName"
                    placeholder="Enter name of channel" />
                <button class="admin-btn" type="submit">Create</button>
            </form>

            <br><br>
            <h3 class="text-center" style="color: rgb(255, 255, 255); font-weight: 700; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin-left: 5px;">List of your Channels:</h3>
            <ul class="nav flex-column" id="renderList">
                <% if (channels && channels.length> 0) { %>
                    <% channels.forEach(channel=> { %>
                        <li><a href="#">
                                <%= channel.channelName %>
                            </a></li>
                        <% }) %>
                            <% } else { %>
                                <li>No channels found.</li>
                                <% } %>
            </ul>
        </nav>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <h1>Welcome</h1>
            <p>This is the main content area.</p>
        </main>
    </div>
    <!-- -->

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const toggleBtn = document.querySelector('.toggle-btn');

            sidebar.classList.toggle('collapsed');

            if (sidebar.classList.contains('collapsed')) {
                toggleBtn.style.left = '10px'; // Move button when sidebar is hidden
            } else {
                toggleBtn.style.left = '260px'; // Reset position when sidebar is visible
            }
        }


        const formEl = document.querySelector('.form');

        formEl.addEventListener('submit', event => {
            event.preventDefault();
            const formData = new FormData(formEl);
            const data = Object.fromEntries(formData);

            fetch('/api/channel', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
                .then(res => res.json())
                .then(data => {
                    displayAllChannel(); // Refresh the list of channels
                })
                .catch(err => console.log(err));
        });

        function displayAllChannel() {
            fetch('/api/user/channels') // Assuming this endpoint returns the list of channels
                .then(res => res.json())
                .then(channels => {
                    const renderList = document.getElementById('renderList');
                    renderList.innerHTML = ''; // Clear the current list

                    if (channels && channels.length > 0) {
                        channels.forEach(channel => {
                            const li = document.createElement('li');
                            const a = document.createElement('a');
                            a.href = '#';
                            a.textContent = channel.channelName;
                            li.appendChild(a);
                            renderList.appendChild(li);
                        });
                    } else {
                        const li = document.createElement('li');
                        li.textContent = 'No channels found.';
                        renderList.appendChild(li);
                    }
                })
                .catch(err => console.log(err));
        }

        // Call displayAllChannel on page load to initially populate the list
        document.addEventListener('DOMContentLoaded', displayAllChannel);
    </script>
</body>

</html>