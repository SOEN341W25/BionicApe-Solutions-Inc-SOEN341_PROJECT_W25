<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Channels</title>
    <link rel="stylesheet" href="style.css">
    <style>
        .sidebar {
            width: 250px;
            height: 100vh;
            background-color: #2575fc;
            position: fixed;
            left: 0;
            top: 0;
            padding-top: 20px;
            color: white;
        }

        .sidebar a {
            display: block;
            color: white;
            padding: 15px 20px;
            text-decoration: none;
        }
        .sidebar a:hover {
            background-color: #6a11cb;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar p-3">
            <div class="text-center mb-3">
                <img src="logo.png" alt="Logo" class="img-fluid" style="max-width: 80px;">
            </div>
            <h5 class="text-center">Object List</h5>
            <ul class="nav flex-column">
                <li><a href="#">EXAMPLE CHANNEL</a></li>
            </ul>
        </nav>
        
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <h1>Welcome</h1>
            <p>This is the main content area.</p>
        </main>
    </div>

</body>
</html>
