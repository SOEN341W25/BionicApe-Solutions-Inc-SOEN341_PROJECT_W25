<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Channels</title>
    <link rel="stylesheet" href="style.css">
    <style>
        .sidebar {
            width: 250px;
            height: 100vh;
            background-color: #2575fc;
            position: fixed;
            left: 0;
            top: 0;
            padding-top: 20px;
            color: white;
            transition: transform 0.3s ease-in-out;
        }

        .sidebar.collapsed {
            transform: translateX(-250px);
        }

        .sidebar a {
            display: block;
            color: white;
            padding: 15px 20px;
            text-decoration: none;
        }
        .sidebar a:hover {
            background-color: #6a11cb;
        }

        .toggle-btn {
            position: fixed;
            left: 260px; /* Adjust based on sidebar width */
            top: 20px;
            background-color: #2575fc;
            color: white;
            border: none;
            padding: 10px;
            cursor: pointer;
            z-index: 1000;
        }

        .logo-container {
            display: flex;
            justify-content: center;
            width: 100%;
        }
       
    </style>
</head>
<body>
    <button class="toggle-btn" onclick="toggleSidebar()">Sidenav</button>

    <a class="logout-btn" href="/logout">Logout</a>

    <div class="sidebar" id="sidebar">
        <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar p-3">
            <div class="logo-container">
                <img src="/bionicape.png" alt="Logo" class="img-fluid center" style="max-width: 80px;">
            </div><br><br>
            <h5 class="text-center">List of your Channels</h5>
            <ul class="nav flex-column">
                <li><a href="#">EXAMPLE CHANNEL</a></li>
            </ul>
        </nav>
        
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <h1>Welcome</h1>
            <p>This is the main content area.</p>
        </main>
    </div>
    <form class ="form">
        <input class="admin-input" type="text" name="channelName" placeholder="channelName"/>
    <button class="admin-btn" type="submit">create</button>
    <a href="http://localhost:3000/api/user/channels" target="_blank">This is a link to see existing channels</a> <!-- Make a fronbtend page for this, ask Mathis-->
    </form>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('collapsed');
        }
        const formEl = document.querySelector('.form');
        
        formEl.addEventListener('submit', event => {
            event.preventDefault();
            const formData = new FormData(formEl);
            const data = Object.fromEntries(formData);

            fetch('/api/channel', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(data => {
                displayAllChannel();
            })
            .catch(err => console.log(err));
        });

        displayAllChannel();

        function createList(data) {
            clearBox('renderList');
            const ul = document.createElement('ul');
            ul.setAttribute('id', 'proList');
            document.getElementById('renderList').appendChild(ul);

            data.forEach(element => {
                const li = document.createElement('li');
                li.setAttribute('class', 'item');
                ul.appendChild(li);

                const a = document.createElement('a');
                a.innerHTML = element.channelName;
                a.setAttribute('href', '/editChannel?channelName=' + element.channelName);
                li.appendChild(a);
            });
        }

        function displayAllChannel() {
            fetch("/api/channel")
                .then(res => res.json())
                .then(data => {
                    createList(data);
                })
                .catch(console.error);
        }

        function clearBox(elementID) {
            document.getElementById(elementID).innerHTML = "";
        }
    </script>
</body>
</html>