<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Channels</title>
    <link rel="stylesheet" href="style.css">
    <style>
        .sidebar {
            width: 250px;
            height: 100vh;
            background-color: #2575fc;
            position: fixed;
            left: 0;
            top: 0;
            padding-top: 20px;
            color: white;
            transition: transform 0.3s ease-in-out;
        }

        .sidebar.collapsed {
            transform: translateX(-250px);
        }

        .sidebar a {
            display: block;
            color: white;
            padding: 15px 20px;
            text-decoration: none;
        }
        .sidebar a:hover {
            background-color: #6a11cb;
        }

        .toggle-btn {
            position: fixed;
            left: 260px; /* Adjust based on sidebar width */
            top: 20px;
            background-color: #2575fc;
            color: white;
            border: none;
            padding: 10px;
            cursor: pointer;
            z-index: 1000;
        }

        .logo-container {
            display: flex;
            justify-content: center;
            width: 100%;
        }
    </style>
</head>
<body>
    <button class="toggle-btn" onclick="toggleSidebar()">Sidenav</button>

    <div class="sidebar" id="sidebar">
        <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar p-3">
            <div class="logo-container">
                <img src="/bionicape.png" alt="Logo" class="img-fluid center" style="max-width: 80px;">
            </div><br><br>
            <h5 class="text-center">List of your Channels</h5>
            <ul class="nav flex-column">
                <li><a href="#">EXAMPLE CHANNEL</a></li>
            </ul>
        </nav>
        
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <h1>Welcome</h1>
            <p>This is the main content area.</p>
        </main>
    </div>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('collapsed');
        }
    </script>
</body>
</html>