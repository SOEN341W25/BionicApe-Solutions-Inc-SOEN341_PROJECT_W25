<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Channel - <%= channel.channelName %></title>
    <link rel="icon" href="/images/favicon.ico"/>
    <link rel="stylesheet" href="/styles/style.css">
    <style>
        /* Custom styles to ensure everything stays in the left column */
        .admin-container {
            width: 100%;
            max-width: 800px;
            margin: 0 auto;
            padding: 2rem;
        }

        .form, .user-list {
            width: 100%;
            margin-bottom: 1.5rem;
        }

        .form input, .form label {
            display: block;
            margin-bottom: 0.5rem;
        }

        .form button {
            width: 100%;
            padding: 0.75rem;
            background-color: #6a11cb;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 1rem;
            cursor: pointer;
        }

        .form button:hover {
            background-color: #2575fc;
        }

        .user-list ul {
            list-style-type: none;
            padding: 0;
        }

        .user-list li {
            margin-bottom: 0.5rem;
        }
    </style>
</head>
<body>

    <div class="admin-container">
        <h1>Edit Channel: <%= channel.channelName %></h1>

        <h2>Current Users in Channel</h2>
        <div id="currentListOfUsers" class="user-list"></div>    

        <h2>List of Users To Be Updated</h2>
        <form class="form" id="renderList">
            <!-- Dynamically populated list of users -->
        </form>
        <p id="resultOfCreation"></p>
    </div>

    <script>
        displayAllUserInCurrentChannel();
        displayAllUser();
        
        function createList(data){
            clearBox('renderList')
            const formEl = document.querySelector('.form');
            data.forEach(renderProductList);
            var button = document.createElement('button');
            button.setAttribute("type","submit");
            button.innerHTML = "Submit";
            formEl.appendChild(button);

            function renderProductList(element, index, arr) {
                var input = document.createElement('input');
                input.setAttribute('type','checkbox');
                input.setAttribute('value',element.username);
                input.setAttribute('id',element.username);
                input.setAttribute('class','inp');

                formEl.appendChild(input);

                var label = document.createElement('label')
                label.setAttribute('for',element.username);
                label.innerHTML = element.username;
                
                formEl.appendChild(label);

                var br = document.createElement('br')
                formEl.appendChild(br);
            }
        }

        function createListUserInChannel(data){
            clearBox('currentListOfUsers')
            var myDiv = document.getElementById("currentListOfUsers")
            var ul = document.createElement('ul');
            ul.setAttribute('id','proList');
            myDiv.appendChild(ul);

            data.users.forEach(renderProductList);
            function renderProductList(element, index, arr) {
                var li = document.createElement('li');
                li.setAttribute('class','item');
                li.innerHTML = element
                ul.appendChild(li);
            }
        }

        function displayAllUser() {
            fetch("/api/user")
            .then((res)=> res.json())
            .then((data)=>{
                createList(data);
            })
            .catch(console.error);
        }

        function displayAllUserInCurrentChannel() {
            fetch("/api/channel/<%= channel.channelName %>")
            .then((res)=> res.json())
            .then((data)=>{
                console.log(JSON.stringify(data))
                createListUserInChannel(data);
            })
            .catch(console.error);
        }

        function clearBox(elementID)
        {
            document.getElementById(elementID).innerHTML = "";
        }

        const formEl = document.querySelector('.form');
        
        formEl.addEventListener('submit', event => {
            event.preventDefault(); // Prevent page refresh on submit
            const checkedValues = [...document.querySelectorAll('.inp:checked')].map(e=>e.value);
            var data = {users:checkedValues};

            fetch('/api/channel/<%= channel.channelName %>',{
                method: 'PUT',
                headers:{
                    'Content-Type':'application/json'
                },
                body: JSON.stringify(data)
            })
            .then((res)=>res.json())
            .then((data)=>{
                document.getElementById("resultOfCreation").innerHTML = "Updated";
                displayAllUserInCurrentChannel();
            })
            .catch(console.error);
        });
    </script>

</body>
</html>
